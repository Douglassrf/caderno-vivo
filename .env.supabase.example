# CADERNO VIVO — EXEMPLO DE AMBIENTE
# Não coloque credenciais reais neste arquivo.
# Copie para .env.local apenas no seu computador/servidor e mantenha fora do Git.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_AQUI_APENAS_A_CHAVE_ANON_PUBLICA
SUPABASE_PROJECT_REF=SEU_PROJECT_REF

TEST_USER_A_EMAIL=usuario-a@example.local
TEST_USER_A_PASSWORD=ALTERE_NO_AMBIENTE_LOCAL

TEST_USER_B_EMAIL=usuario-b@example.local
TEST_USER_B_PASSWORD=ALTERE_NO_AMBIENTE_LOCAL

# ATENÇÃO:
# As variáveis abaixo são SOMENTE SERVER-SIDE.
# Nunca importar, embutir ou expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=<SERVER_SIDE_ONLY_DO_NOT_COMMIT>
MERCADO_PAGO_ACCESS_TOKEN=<SERVER_SIDE_ONLY_DO_NOT_COMMIT>
MERCADO_PAGO_WEBHOOK_SECRET=<SERVER_SIDE_ONLY_DO_NOT_COMMIT>

APP_ORIGIN=http://127.0.0.1:8766
EXPORT_BUCKET=private-exports
